{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Grants the main window only the shell lifecycle, window dragging, application version, and operating-system facts it consumes.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:app:allow-version",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-arch"
  ]
}
